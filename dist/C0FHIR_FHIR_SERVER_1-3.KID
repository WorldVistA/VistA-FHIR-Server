 S DESC(2)="----------------------------------------"
"RTN","C0FHIRSET",26,0)
 S DESC(3)="INPUTS:"
"RTN","C0FHIRSET",27,0)
 S DESC(4)="  1. DFN (Req): Internal Patient IEN from File #2."
"RTN","C0FHIRSET",28,0)
 S DESC(5)="  2. ENCPTR (Opt): Internal Encounter IEN from File #409.68."
"RTN","C0FHIRSET",29,0)
