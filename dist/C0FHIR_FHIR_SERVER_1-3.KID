"RTN","C0FHIRLA",9,0)
 W "------------------------------------------------------------",!
"RTN","C0FHIRLA",10,0)
 ;
"RTN","C0FHIRLA",11,0)
 ; Loop through File #60
"RTN","C0FHIRLA",12,0)
 S TST=0 F  S TST=$O(^LAB(60,TST)) Q:'TST  D
"RTN","C0FHIRLA",13,0)
 . S TNAME=$$GET1^DIQ(60,TST_",",.01)
"RTN","C0FHIRLA",14,0)
