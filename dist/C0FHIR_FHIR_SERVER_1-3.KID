"RTN","C0FHIRLA",30,0)
 W !,"Total Active CH Tests: "_TOTAL
"RTN","C0FHIRLA",31,0)
 W !,"Tests Missing LOINC:   "_MISS
"RTN","C0FHIRLA",32,0)
 W !,"Mapping Coverage:      "_$J((TOTAL-MISS)/TOTAL*100,0,1)_"%",!
"RTN","C0FHIRLA",33,0)
 I MISS>0 W !,"Note: Tests marked [!!] will appear as 'VistA-ID' in FHIR bundles.",!
"RTN","C0FHIRLA",34,0)
