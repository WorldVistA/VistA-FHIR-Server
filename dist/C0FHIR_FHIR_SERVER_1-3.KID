 N TST,TNAME,LOINC,Lptr,TOTAL,MISS,CNT S (TOTAL,MISS,CNT)=0
"RTN","C0FHIRLA",6,0)
 W !!,"--- C0FHIR Lab-to-LOINC Mapping Audit ---",!
"RTN","C0FHIRLA",7,0)
 W !,"Checking active Chemistry tests for missing LOINC codes...",!
"RTN","C0FHIRLA",8,0)
