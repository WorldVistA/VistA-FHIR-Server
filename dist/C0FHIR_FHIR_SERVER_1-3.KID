"RTN","C0FHIRUN",23,0)
 N NAME,IEN,FDA,ERR
"RTN","C0FHIRUN",24,0)
 S NAME="C0FHIR GET FULL BUNDLE"
"RTN","C0FHIRUN",25,0)
 S IEN=$O(^DIC(8994,"B",NAME,0))
"RTN","C0FHIRUN",26,0)
 I IEN D
"RTN","C0FHIRUN",27,0)
 . W !,"Deleting RPC: "_NAME_"..."
"RTN","C0FHIRUN",28,0)
 . S FDA(8994,IEN_",",.01)="@"
"RTN","C0FHIRUN",29,0)
 . D FILE^DIE("E","FDA","ERR")
