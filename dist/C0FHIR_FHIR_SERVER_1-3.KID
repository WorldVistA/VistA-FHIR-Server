"RTN","C0FHIRLA",15,0)
 . I $$GET1^DIQ(60,TST_",",4)'="CH" Q
"RTN","C0FHIRLA",16,0)
 . ; Filter: Skip inactive tests
"RTN","C0FHIRLA",17,0)
 . I $$GET1^DIQ(60,TST_",",132)'="" Q
"RTN","C0FHIRLA",18,0)
 . ;
"RTN","C0FHIRLA",19,0)
 . S TOTAL=TOTAL+1
